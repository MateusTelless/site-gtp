# Configure these through hosting secrets. Do not commit real secrets.
AUTH_PROVIDER=password
# Obrigatório: sem ADMIN_EMAILS ninguém acessa o painel. Separe vários e-mails por vírgula.
ADMIN_EMAILS=admin@example.com,equipe@example.com
ADMIN_SETUP_EMAIL=admin@example.com
# Random 32-byte token and an ISO expiry, configured only during initial setup:
# ADMIN_SETUP_TOKEN=
# ADMIN_SETUP_EXPIRES=
# Optional one-use password recovery, issued by the hosting owner:
# ADMIN_RESET_TOKEN=
# ADMIN_RESET_EXPIRES=
# ADMIN_RESET_USERNAME=
# Legacy adapters remain available explicitly: sites / cloudflare-access.
# Sem AUTH_PROVIDER definido, o painel fica fechado para todos.
