# Configure these through hosting secrets. Do not commit real secrets.
AUTH_PROVIDER=password
# Obrigatório: sem ADMIN_EMAILS ninguém acessa o painel. Separe vários e-mails por vírgula.
ADMIN_EMAILS=admin@example.com,equipe@example.com
ADMIN_SETUP_EMAIL=admin@example.com
# Random 32-byte token and an ISO expiry, configured only during initial setup:
# ADMIN_SETUP_TOKEN=
# ADMIN_SETUP_EXPIRES=
# Optional one-use password recovery, issued by the hosting owner:
# ADMIN_RESET_TOKEN=
# ADMIN_RESET_EXPIRES=
# ADMIN_RESET_USERNAME=
# Opcional: pedidos de aula teste também vão para a planilha do Google (integracoes/planilha-aula-teste/LEIA-ME.md).
# SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/ID_DA_IMPLANTACAO/exec
# SHEETS_WEBHOOK_SECRET=
# Opcional: matrículas do site também vão para a planilha do painel, sem dados pessoais (integracoes/planilha-matriculas/LEIA-ME.md).
# MATRICULAS_SHEET_URL=https://script.google.com/macros/s/ID_DA_IMPLANTACAO/exec
# MATRICULAS_SHEET_SECRET=
# Opcional: ponte da catraca (ponte-catraca/). Token longo e aleatório (mín. 24 caracteres), o mesmo do config.json da ponte.
# Sem ele, /api/catraca/* responde 503. Tolerância = dias de atraso de parcela antes de bloquear (padrão 5).
# CATRACA_TOKEN=
# CATRACA_TOLERANCIA_DIAS=5
# Opcional: medição do site (public/medicao.js). Só carrega depois que o visitante aceita os cookies.
# GA4_ID=G-XXXXXXXXXX
# META_PIXEL_ID=000000000000000
# Legacy adapters remain available explicitly: sites / cloudflare-access.
# Sem AUTH_PROVIDER definido, o painel fica fechado para todos.
# Opcional: conferência automática dos documentos do desconto de militar/dependente (app/doc-check.ts, Claude da Anthropic).
# Sem a chave, o desconto fica "a conferir" para a equipe. Cerca de US$ 0,06 por matrícula com desconto de militar.
# ANTHROPIC_API_KEY=
# Opcional: contrato pelo DocuSeal (app/docuseal.ts; passo a passo em integracoes/docuseal/LEIA-ME.md). Sem a chave (ou sem o modelo do contrato enviado no painel), a equipe registra o contrato à mão.
# DOCUSEAL_API_KEY=
# Código longo e aleatório (mín. 24 caracteres) do endereço do aviso: https://SEU-SITE/api/docuseal/webhook/<código>
# DOCUSEAL_WEBHOOK_TOKEN=
# Opcionais: conta na Europa (https://api.docuseal.eu); assinatura do GETEPE (nome escrito ou link público de uma imagem); e-mail do GETEPE no contrato.
# DOCUSEAL_API_URL=https://api.docuseal.com
# DOCUSEAL_GETEPE_ASSINATURA=
# DOCUSEAL_GETEPE_EMAIL=
# Opcional: cópia do contrato assinado na pasta "Contratos assinados" do Google Drive, uma subpasta por turma (integracoes/drive-contratos/LEIA-ME.md).
# CONTRATOS_DRIVE_URL=https://script.google.com/macros/s/ID_DA_IMPLANTACAO/exec
# CONTRATOS_DRIVE_SECRET=
# RA de aluno novo: o site continua a numeração do Lexus. Ao publicar, informe o último RA da coluna B da planilha Alunos 2027.
# RA_ULTIMO_LEXUS=
